-		serde_json::to_vec(&xlated).map_err(AIError::RequestMarshal)
+		let (xlated, reasoning_per_assistant) = translate_internal(typed);
+		if reasoning_per_assistant.iter().all(Option::is_none) {
+			return serde_json::to_vec(&xlated).map_err(AIError::RequestMarshal);
+		}
+		// Anthropic assistant turns can carry Thinking blocks; for OpenAI-compatible
+		// backends that gate multi-turn requests on `reasoning_content` (e.g. Kimi
